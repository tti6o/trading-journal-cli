flowchart TD
    %% 定义主要流程 - 更清晰的布局
    START([开始技术分析]) --> INPUT[输入交易对]
    INPUT --> DATA{获取市场数据}

    %% 数据获取阶段
    DATA -->|成功| OHLCV[OHLCV K线数据]
    DATA -->|失败| ERROR([数据获取失败])

    %% 技术分析核心流程
    OHLCV --> ANALYSIS{技术分析引擎}

    %% RSI分析分支
    ANALYSIS --> RSI_BRANCH[RSI分析器]
    RSI_BRANCH --> RSI_CALC[计算14期RSI]
    RSI_CALC --> RSI_EVAL{RSI信号评估}
    RSI_EVAL -->|RSI ≤ 30| RSI_BUY[超卖买入信号]
    RSI_EVAL -->|RSI ≥ 70| RSI_SELL[超买卖出信号]
    RSI_EVAL -->|30 < RSI < 70| RSI_NEUTRAL[中性信号]

    %% 斐波那契分析分支
    ANALYSIS --> FIB_BRANCH[斐波那契分析器]
    FIB_BRANCH --> SWING_DETECT[识别关键高低点]
    SWING_DETECT --> FIB_CALC{计算斐波那契水平}

    %% 斐波那契回调分析
    FIB_CALC --> FIB_RETRACEMENT[回调分析]
    FIB_RETRACEMENT --> FIB_LEVELS[23.6% | 38.2% | 50% | 61.8% | 78.6%]
    FIB_LEVELS --> FIB_PROXIMITY{价格接近度检查}
    FIB_PROXIMITY -->|接近关键位| FIB_SIGNAL[🎯 斐波那契信号]
    FIB_PROXIMITY -->|距离太远| FIB_NO_SIGNAL[无信号]

    %% 斐波那契扩展分析
    FIB_CALC --> FIB_EXTENSION[扩展分析]
    FIB_EXTENSION --> FIB_EXT_LEVELS[127.2% | 161.8% | 261.8%]
    FIB_EXT_LEVELS --> FIB_EXT_CHECK{扩展位检查}
    FIB_EXT_CHECK -->|到达目标位| FIB_TARGET[🏆 目标位信号]
    FIB_EXT_CHECK -->|未到达| FIB_EXT_NO_SIGNAL[无扩展信号]

    %% 信号整合阶段
    RSI_BUY --> SIGNAL_MERGE[信号整合引擎]
    RSI_SELL --> SIGNAL_MERGE
    RSI_NEUTRAL --> SIGNAL_MERGE
    FIB_SIGNAL --> SIGNAL_MERGE
    FIB_TARGET --> SIGNAL_MERGE
    FIB_NO_SIGNAL --> SIGNAL_MERGE
    FIB_EXT_NO_SIGNAL --> SIGNAL_MERGE

    %% 置信度计算
    SIGNAL_MERGE --> CONFIDENCE[计算信号置信度]
    CONFIDENCE --> FINAL_SIGNAL{生成最终信号}

    %% 最终输出
    FINAL_SIGNAL -->|高置信度| HIGH_CONF[📈 强信号 - 发送通知]
    FINAL_SIGNAL -->|中等置信度| MED_CONF[📊 中等信号 - 记录日志]
    FINAL_SIGNAL -->|低置信度| LOW_CONF[📝 弱信号 - 仅记录]

    %% 通知系统
    HIGH_CONF --> NOTIFICATION[邮件通知系统]
    NOTIFICATION --> EMAIL_SENT([📧 邮件已发送])

    %% 日志记录
    MED_CONF --> LOG[记录到分析日志]
    LOW_CONF --> LOG
    LOG --> COMPLETE[分析完成]

    %% 错误处理
    ERROR --> RETRY{重试?}
    RETRY -->|是| DATA
    RETRY -->|否| FAILED([分析失败])

    %% 数据源说明
    subgraph DataSources [数据源]
        BINANCE[币安API]
        KLINES[K线数据]
        PRICES[实时价格]
        BINANCE --> KLINES
        BINANCE --> PRICES
    end

    %% 技术指标详解
    subgraph TechnicalIndicators [技术指标详解]
        subgraph RSI_DETAIL [RSI指标]
            RSI_FORMULA[RSI = 100 - 100/(1+RS)]
            RSI_RS[RS = 平均上涨幅度/平均下跌幅度]
            RSI_PERIOD[默认14期计算]
        end

        subgraph FIB_DETAIL [斐波那契分析]
            FIB_RATIO[黄金比例: 0.618, 0.382]
            FIB_SUPPORT[回调位作为支撑/阻力]
            FIB_TARGET_CALC[扩展位作为目标价]
        end
    end

    %% 配置管理
    subgraph ConfigManagement [配置管理]
        CONFIG_FILE[config/config.ini]
        RSI_CONFIG[RSI参数配置]
        FIB_CONFIG[斐波那契参数配置]
        EMAIL_CONFIG[邮件通知配置]
    end

    %% 连接数据源
    DATA -.-> BINANCE
    OHLCV -.-> KLINES

    %% 连接配置
    RSI_BRANCH -.-> RSI_CONFIG
    FIB_BRANCH -.-> FIB_CONFIG
    NOTIFICATION -.-> EMAIL_CONFIG

