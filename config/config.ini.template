# 交易日志 CLI 工具配置文件
# 复制此文件为 config.ini 并填入您的配置信息

[binance]
# 币安 API 配置
api_key = your_binance_api_key_here
api_secret = your_binance_api_secret_here
# 是否使用测试网 (可选)
testnet = false

[exchange]
name = binance
sandbox = false
rate_limit = true

[proxy]
enabled = true
http_proxy = http://127.0.0.1:7890
https_proxy = http://127.0.0.1:7890

[scheduler]
# 定时任务配置
enabled = true
# 数据同步间隔 (小时)
sync_interval_hours = 4
# 首次同步获取的天数
initial_sync_days = 30

[technical_analysis]
# 技术分析功能配置 (完整版本 - RSI + 斐波那契分析)
enabled = true
# 技术分析执行间隔 (分钟)
analysis_interval_minutes = 60
# K线数据间隔 (1m, 5m, 15m, 1h, 4h, 1d)
kline_interval = 1h
# K线数据获取数量
kline_limit = 200
# 是否启用分析功能
analysis_enabled = true
# 是否自动检测监控的交易对
auto_detect_symbols = true
# 手动指定监控的交易对 (逗号分隔)
monitored_symbols = BTCUSDT,ETHUSDT,ADAUSDT,BNBUSDT,SOLUSDT,DOTUSDT,LINKUSDT,AVAXUSDT
# 信号置信度阈值 (0.0-1.0)
confidence_threshold = 0.5

[rsi]
# RSI指标配置 (MVP核心指标)
period = 14
# 超卖阈值
oversold = 30
# 超买阈值
overbought = 70

[fibonacci]
# 斐波那契回调和扩展分析配置
# 启用斐波那契分析
enabled = true
# 寻找高低点的回看周期
lookback_period = 20
# 最小价格变化百分比(过滤噪音)
min_price_change_pct = 0.05
# 价格接近斐波那契水平的阈值百分比
proximity_threshold_pct = 0.02
# 斐波那契回调水平 (逗号分隔)
retracement_levels = 0.236,0.382,0.5,0.618,0.786
# 斐波那契扩展水平 (逗号分隔)  
extension_levels = 1.000,1.618,2.618

[indicators]
# 技术指标配置 - 启用/禁用各种指标
sma_enabled = true
sma_weight = 1.0
ema_enabled = true
ema_weight = 1.0
rsi_enabled = true
rsi_weight = 1.2
macd_enabled = true
macd_weight = 1.1
bollinger_enabled = true
bollinger_weight = 1.0
volume_sma_enabled = true
volume_sma_weight = 0.8
stoch_enabled = true
stoch_weight = 1.0

[email]
# 邮件通知配置
enabled = true
# SMTP 服务器配置
smtp_server = smtp.gmail.com
smtp_port = 587
use_tls = true
# 发送邮箱账号
username = your_email@gmail.com
password = your_app_password
# 发送者名称
sender_name = 交易信号助手
# 通知收件人邮箱 (逗号分隔)
notification_recipients = your_email@example.com,trader@example.com

[logging]
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
level = INFO
# 是否启用文件日志
file_log_enabled = true
# 文件日志路径
log_file_path = data/app.log

[database]
# 数据库配置
db_path = data/trading_journal.db

[signal_rules]
# 信号规则配置
# 移动平均交叉
ma_cross_enabled = true
ma_cross_weight = 1.0
# RSI反转
rsi_reversal_enabled = true
rsi_reversal_weight = 0.8
# MACD交叉
macd_cross_enabled = true
macd_cross_weight = 0.9
# 布林带突破
bollinger_bands_enabled = true
bollinger_bands_weight = 0.7
# 成交量确认
volume_confirmation_enabled = true
volume_confirmation_weight = 0.5